{
  "name": "framio-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "build:ui": "turbo run build:ui",
    "dev:ui": "turbo run dev:ui",
    "build:binary": "turbo run build:binary",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test:effect test:integration",
    "test:effect": "turbo run test:effect",
    "test:integration": "turbo run test:integration",
    "test:all": "turbo run test:effect test:integration",
    "check": "turbo run typecheck test:effect test:integration",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "dev:landing": "turbo run dev --filter=@framio/landing",
    "build:landing": "turbo run build --filter=@framio/landing",
    "deploy:landing": "turbo run deploy --filter=@framio/landing"
  },
  "devDependencies": {
    "turbo": "^2.10.0"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24"
  },
  "homepage": "https://framio.design",
  "patchedDependencies": {
    "puppeteer-core@25.12.0": "patches/puppeteer-core@25.12.0.patch"
  }
}
