---
import SEO from "../components/SEO.astro";
import { SITE_URL, REPO_URL } from "../lib/site";
import "../styles/global.css";
const { title, description } = Astro.props.frontmatter;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "@id": `${SITE_URL}/docs/#article`,
      headline: title,
      description,
      url: `${SITE_URL}/docs/`,
      inLanguage: "en",
      author: {
        "@type": "Person",
        name: "Harshit",
        url: "https://github.com/C-W-D-Harshit",
      },
      about: { "@id": `${SITE_URL}/#software` },
      isPartOf: { "@id": `${SITE_URL}/#website` },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Framio",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Documentation",
          item: `${SITE_URL}/docs/`,
        },
      ],
    },
  ],
};
const sections = [
  "Install",
  "Quick start",
  "Use Framio with Claude Code or Codex",
  "Where designs live",
  "DESIGN.md",
  "Comments and selections",
  "Responsive frames",
  "Compare a design with your app",
  "Commands",
  "Support and source",
];
const slug = (text: string) =>
  text
    .toLowerCase()
    .replace(/[^a-z0-9 -]/g, "")
    .replace(/ /g, "-");
// Links to other sites in the Markdown body open in a new tab.
const body = (await Astro.slots.render("default")).replace(
  /<a href="(https?:\/\/(?!framio\.design)[^"]+)"/g,
  '<a href="$1" target="_blank" rel="noopener noreferrer"',
);
---

<!doctype html>
<html lang="en">
  <head>
    <SEO
      title={`${title} · Framio`}
      description={description}
      path="/docs/"
      schema={schema}
    />
  </head>
  <body class="bg-landing-page font-sans text-landing-ink antialiased">
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <header class="border-b border-landing-line">
      <nav
        aria-label="Main navigation"
        class="mx-auto flex h-20 max-w-[1200px] items-center justify-between px-5 md:px-6"
      >
        <a href="/" aria-label="Framio home">
          <img
            src="/assets/brand/framio-wordmark-on-dark.png"
            alt="Framio"
            width="797"
            height="244"
            class="h-[22px] w-auto"
          />
        </a>
        <div class="flex items-center gap-6 text-sm text-landing-muted">
          <a href="/">Home</a>
          <a href={REPO_URL} target="_blank" rel="noopener noreferrer">
            GitHub
          </a>
        </div>
      </nav>
    </header>
    <div class="mx-auto grid max-w-[1200px] gap-12 px-5 py-12 md:px-6 md:py-20 lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-20">
      <aside>
        <details class="rounded-xl border border-landing-line p-4 lg:hidden">
          <summary class="cursor-pointer select-none text-sm font-medium">
            On this page
          </summary>
          <nav aria-label="Mobile documentation sections">
            <ul class="mt-4 flex flex-col gap-1 text-sm text-landing-muted">
              {sections.map((s) => (
                <li>
                  <a class="block py-2" href={`#${slug(s)}`}>
                    {s}
                  </a>
                </li>
              ))}
            </ul>
            <a
              class="mt-4 inline-block text-sm underline underline-offset-4"
              href="/docs.md"
            >
              Read as Markdown
            </a>
          </nav>
        </details>
        <nav
          aria-label="Documentation sections"
          class="hidden lg:sticky lg:top-8 lg:block"
        >
          <a href="/docs/" aria-current="page" class="font-medium">
            Documentation
          </a>
          <ul class="mt-5 flex flex-col gap-1 text-sm text-landing-muted">
            {sections.map((s) => (
              <li>
                <a class="block py-2" href={`#${slug(s)}`}>
                  {s}
                </a>
              </li>
            ))}
          </ul>
          <a
            class="mt-6 inline-block text-sm text-landing-muted underline underline-offset-4"
            href="/docs.md"
          >
            Read as Markdown
          </a>
        </nav>
      </aside>
      <main id="main-content" class="min-w-0 max-w-[760px]">
        <nav aria-label="Breadcrumb" class="mb-6 text-sm text-landing-muted">
          <a href="/">Framio</a>
          <span aria-hidden="true" class="mx-2">
            /
          </span>
          <span>Documentation</span>
        </nav>
        <h1 class="text-[36px] leading-[1.1] font-semibold tracking-[-0.035em] md:text-[48px]">
          {title}
        </h1>
        <article class="docs-content mt-8">
          <Fragment set:html={body} />
        </article>
      </main>
    </div>
    <footer class="border-t border-landing-line px-5 py-10 text-sm text-landing-muted">
      <div class="mx-auto flex max-w-[1200px] flex-wrap justify-between gap-4">
        <a href="/">Framio, a design canvas for coding agents.</a>
        <a
          href={`${REPO_URL}/blob/main/LICENSE`}
          target="_blank"
          rel="noopener noreferrer"
        >
          Free and open source · MIT license
        </a>
      </div>
    </footer>
  </body>
</html>
