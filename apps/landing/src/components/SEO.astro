---
import geistFont from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import { SITE_URL, SITE_TITLE, SITE_DESCRIPTION } from "../lib/site";
interface Props {
  title?: string;
  description?: string;
  path?: string;
  schema?: Record<string, unknown>;
  noindex?: boolean;
}
const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  path = "/",
  schema,
  noindex = false,
} = Astro.props;
const canonical = new URL(path, SITE_URL).href;
const image = `${SITE_URL}/assets/brand/framio-social.png`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta
  name="robots"
  content={
    noindex
      ? "noindex, follow"
      : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  }
/>
<link rel="preload" href={geistFont} as="font" type="font/woff2" crossorigin />
<meta name="theme-color" content="#0A0A0B" />
<link rel="canonical" href={canonical} />
<link
  rel="icon"
  type="image/png"
  sizes="32x32"
  href="/assets/brand/favicon-32.png"
/>
<link
  rel="icon"
  type="image/png"
  sizes="48x48"
  href="/assets/brand/favicon-48.png"
/>
<link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png" />
<meta property="og:site_name" content="Framio Alpha" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content="Framio Studio, a design canvas for coding agents, showing a React invoice design and pinned feedback."
/>
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta
  name="twitter:image:alt"
  content="Framio Studio with a React invoice design and pinned feedback."
/>
{schema && (
  <script
    type="application/ld+json"
    set:html={JSON.stringify(schema).replace(/</g, "\u003c")}
  />
)}
